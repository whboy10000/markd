# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 应用自身产物（配置、快照写在用户目录，这里只防误提交）
.markd/
*.log

# 代码生成产物
generated-images/

# Pandoc 随包二进制：由 scripts/fetch-pandoc.sh 在打包时下载，不入库
/vendor/

# 打包产物（CI 会重新构建，不入库）
dist/
*.dmg
*.zip
Markd-*.tar.gz
Markd-*-setup.exe
Markd-*.deb

# 完整图标素材库：只作本地参考，实际打包用 assets/file-icons 里的子集
assets/icons/

# 压测语料（由生成脚本按需重建，单文件最大 24 MB，不入库）
test_docs/

# Qoder 会话元数据
.qwen/

# Agent 会话与本地产物（内存日志等，不入库）
.workbuddy/

# Python 缓存（gen-stress-doc.py 的伴生产物）
__pycache__/
*.pyc
